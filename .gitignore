# Ephemeral runtime symlink the orchestrating mill drops here to point
# at the current epic workspace. No code in this repo reads or writes
# it; ignored so it doesn't get re-tracked accidentally.
_epic
dist/
build/
site/
docker-compose.override.yml
# Transient board browser smoke screenshot. The implement gate writes it
# to <clone>/artifacts/board.png and moves it out to the workspace; this
# ignore is defence-in-depth so a lingering copy is never staged.
/artifacts/board.png
# Audit frontier-orchestrator per-run memory artifacts. Written by
# the audit periodic agent at runtime (via write_file tool); never
# commit these.
/artifacts/audit-run-*
# Stray pip-install output file accidentally committed (see ticket 20260621T173905Z)
=8
# actionlint binary downloaded by security-audit.yml at runtime
actionlint
# Mill agent output artifacts (diagnostic/periodic agent runs)
.mill-output.json
# Stray full-suite pytest output file accidentally committed (see
# investigation-ticket capability-removal ticket): `pytest > pyt_full.out`.
pyt_full.out
# Stray doc-agent scratch artifacts — the real ledger is runtime-managed
# via settings.memory_file_for("doc", board_id). These are one-off commits.
/doc_agent_output.json
/.doc_memory_ledger.md
# Sandbox workspace clones of external repos
.work/
# lychee link-checker cache
.lychee-cache/
# Vendored @robotsix/ui config panel build output — built during Docker
# image creation, never committed.
src/robotsix_mill/runtime/static/robotsix-ui-vanilla.js
src/robotsix_mill/runtime/static/robotsix-ui.css

# uv project environment when CI sets UV_PROJECT_ENVIRONMENT=system
/system/
